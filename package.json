{
  "name": "smridha-dev",
  "version": "2.0.0",
  "private": true,
  "description": "Personal portfolio of MD Sobhan Mridha",
  "scripts": {
    "build:html": "node build.mjs",
    "build:css": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "build": "npm run build:html && npm run build:css",
    "dev": "node build.mjs && concurrently -k -n css,web \"tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch\" \"serve . -l 3000\"",
    "start": "serve . -l 3000"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "serve": "^14.2.7",
    "tailwindcss": "^3.4.17"
  }
}
